# Copy to .env. Nothing here is read by code directly: compose passes it to the containers.

# Password of the PostgreSQL user created on first start.
POSTGRES_PASSWORD=change-me

# Encrypts the model-provider keys users save in Settings. The API refuses to start without it.
# Generate one:  openssl rand -base64 32 | tr '+/' '-_'
# Changing it later makes every saved provider key unreadable.
SECRETS_KEY=

# Set to false to stop new accounts from being created.
ALLOW_REGISTRATION=true

# Days a login stays valid.
SESSION_TTL_DAYS=30

# Largest PDF accepted, in megabytes.
MAX_UPLOAD_MB=50

# Set to true when the site is served over HTTPS.
COOKIE_SECURE=false

# Set to true to let users connect to a model router on a private address
# (localhost, 192.168.x.x, host.docker.internal). Leave false on a public server.
ALLOW_PRIVATE_PROVIDER_URLS=false
